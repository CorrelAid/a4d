#!/usr/bin/env bash
# Runs the same checks CI runs, before the push leaves the machine.
# Installed by `just hooks`. Bypass a single push with `git push --no-verify`.
set -euo pipefail

if ! command -v just >/dev/null 2>&1; then
    echo "pre-push: 'just' not found, skipping checks" >&2
    exit 0
fi

echo "pre-push: running 'just ci' (~40s)..."
just ci
